<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Gaming Laptops – Compare Prices in Norway | TechKjop</title>
<meta name="description" content="Compare gaming laptop prices in Norway. Find gaming laptops, specifications, prices and the best deals from Norwegian stores.">

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f7fa;
  color: #172033;
}

header {
  background: #111827;
  color: white;
  padding: 18px 20px;
}

.header-inner {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  color: white;
  text-decoration: none;
}

nav {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

nav a {
  color: #dbe4f0;
  text-decoration: none;
  font-size: 14px;
}

nav a:hover {
  color: white;
}

.hero {
  background: white;
  padding: 45px 20px 35px;
  border-bottom: 1px solid #e5e7eb;
}

.hero-inner {
  max-width: 1200px;
  margin: auto;
}

.hero h1 {
  margin: 0 0 12px;
  font-size: 38px;
}

.hero p {
  margin: 0;
  max-width: 800px;
  color: #5b6577;
  line-height: 1.6;
}

.controls {
  max-width: 1200px;
  margin: 25px auto;
  padding: 0 20px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.search-box {
  flex: 1;
  min-width: 250px;
  padding: 14px 16px;
  border: 1px solid #d5dbe5;
  border-radius: 9px;
  font-size: 15px;
}

.sort-box {
  padding: 14px 16px;
  border: 1px solid #d5dbe5;
  border-radius: 9px;
  background: white;
  font-size: 15px;
}

.products {
  max-width: 1200px;
  margin: 0 auto 50px;
  padding: 0 20px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.card {
  background: white;
  border: 1px solid #e2e6ed;
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .15s ease, box-shadow .15s ease;
}

.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0,0,0,.08);
}

.image-wrap {
  height: 220px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  border-bottom: 1px solid #edf0f4;
}

.image-wrap img {
  max-width: 100%;
  max-height: 185px;
  object-fit: contain;
}

.card-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card h2 {
  margin: 0 0 10px;
  font-size: 20px;
  line-height: 1.3;
}

.description {
  color: #667085;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 15px;
}

.specs {
  display: grid;
  gap: 7px;
  margin-bottom: 18px;
}

.spec {
  font-size: 13px;
  color: #465164;
}

.spec strong {
  color: #172033;
}

.price {
  font-size: 25px;
  font-weight: 800;
  margin-top: auto;
  margin-bottom: 5px;
}

.store {
  color: #667085;
  font-size: 13px;
  margin-bottom: 14px;
}

.offers {
  margin-bottom: 15px;
}

.offer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 0;
  border-top: 1px solid #edf0f4;
  font-size: 13px;
}

.offer-price {
  font-weight: 700;
}

.deal-button {
  display: block;
  width: 100%;
  text-align: center;
  background: #111827;
  color: white;
  text-decoration: none;
  padding: 13px 15px;
  border-radius: 8px;
  font-weight: 700;
}

.deal-button:hover {
  background: #273449;
}

.empty,
.loading {
  max-width: 1200px;
  margin: 40px auto;
  padding: 30px 20px;
  text-align: center;
  color: #667085;
}

footer {
  background: #111827;
  color: #cbd5e1;
  padding: 35px 20px;
  margin-top: 50px;
}

.footer-inner {
  max-width: 1200px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  gap: 30px;
  flex-wrap: wrap;
}

footer a {
  color: #cbd5e1;
  text-decoration: none;
}

@media (max-width: 900px) {
  .products {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .header-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  nav {
    gap: 12px;
  }

  .hero h1 {
    font-size: 30px;
  }

  .products {
    grid-template-columns: 1fr;
  }

  .image-wrap {
    height: 240px;
  }
}
</style>
</head>

<body>

<header>
  <div class="header-inner">
    <a href="/" class="logo">TechKjop</a>

    <nav>
      <a href="/">Home</a>
      <a href="/graphics-cards.html">Graphics Cards</a>
      <a href="/ram.html">RAM</a>
      <a href="/gaming-laptops.html">Gaming Laptops</a>
      <a href="/gaming-pc.html">Gaming PC</a>
      <a href="/laptop-tilbud.html">Laptop Deals</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <h1>Gaming Laptops</h1>
    <p>
      Compare gaming laptop prices, specifications and offers.
      Find the best gaming laptop deals available in Norway.
    </p>
  </div>
</section>

<div class="controls">
  <input
    id="search"
    class="search-box"
    type="text"
    placeholder="Search gaming laptops..."
  >

  <select id="sort" class="sort-box">
    <option value="default">Sort: Recommended</option>
    <option value="low">Price: Low to High</option>
    <option value="high">Price: High to Low</option>
    <option value="name">Name: A–Z</option>
  </select>
</div>

<div id="status" class="loading">
  Loading gaming laptops...
</div>

<main id="products" class="products"></main>

<footer>
  <div class="footer-inner">
    <div>
      <strong>TechKjop</strong>
      <p>Compare technology prices in Norway.</p>
    </div>

    <div>
      <a href="/about.html">About Us</a><br>
      <a href="/contact.html">Contact</a><br>
      <a href="/privacy.html">Privacy Policy</a><br>
      <a href="/affiliate-disclosure.html">Affiliate Disclosure</a>
    </div>
  </div>
</footer>

<script>

let allLaptops = [];

function escapeHtml(value) {
  if (value === null || value === undefined) return "";

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function getPrice(product) {
  if (typeof product.price === "number") {
    return product.price;
  }

  if (typeof product.lowestPrice === "number") {
    return product.lowestPrice;
  }

  if (product.price) {
    const number = parseFloat(
      String(product.price).replace(/[^\d.,]/g, "").replace(",", ".")
    );

    if (!isNaN(number)) return number;
  }

  if (product.offers && product.offers.length) {
    const prices = product.offers
      .map(o => parseFloat(String(o.price || "").replace(/[^\d.,]/g, "").replace(",", ".")))
      .filter(p => !isNaN(p));

    if (prices.length) return Math.min(...prices);
  }

  return null;
}

function formatPrice(price) {
  if (price === null || price === undefined || isNaN(price)) {
    return "Price unavailable";
  }

  return new Intl.NumberFormat("nb-NO", {
    style: "currency",
    currency: "NOK",
    maximumFractionDigits: 0
  }).format(price);
}

function getSpecs(product) {

  const specs = product.specifications || {};

  return {
    cpu: specs.cpu || product.cpu || "",
    gpu: specs.gpu || product.gpu || "",
    ram: specs.ram || product.ram || "",
    storage: specs.storage || product.storage || "",
    screen: specs.screen || product.screen || ""
  };
}

function getImage(product) {

  return (
    product.image ||
    product.imageUrl ||
    product.thumbnail ||
    "/images/placeholder.jpg"
  );
}

function getBestStore(product) {

  if (
    product.bestStore
  ) {
    return product.bestStore;
  }

  if (
    product.offers &&
    product.offers.length
  ) {
    const sorted = [...product.offers].sort((a, b) => {
      const pa = parseFloat(String(a.price || "").replace(/[^\d.,]/g, "").replace(",", "."));
      const pb = parseFloat(String(b.price || "").replace(/[^\d.,]/g, "").replace(",", "."));

      return pa - pb;
    });

    return sorted[0]?.store || sorted[0]?.merchant || "";
  }

  return "";
}

function getBestUrl(product) {

  if (product.url) return product.url;

  if (product.affiliateUrl) return product.affiliateUrl;

  if (product.link) return product.link;

  if (
    product.offers &&
    product.offers.length
  ) {
    const sorted = [...product.offers].sort((a, b) => {
      const pa = parseFloat(String(a.price || "").replace(/[^\d.,]/g, "").replace(",", "."));
      const pb = parseFloat(String(b.price || "").replace(/[^\d.,]/g, "").replace(",", "."));

      return pa - pb;
    });

    return (
      sorted[0]?.affiliateUrl ||
      sorted[0]?.url ||
      sorted[0]?.link ||
      "#"
    );
  }

  return "#";
}

function renderProducts(list) {

  const container = document.getElementById("products");
  const status = document.getElementById("status");

  container.innerHTML = "";

  if (!list.length) {
    status.style.display = "block";
    status.className = "empty";
    status.textContent = "No gaming laptops found.";
    return;
  }

  status.style.display = "none";

  list.forEach(product => {

    const specs = getSpecs(product);
    const price = getPrice(product);
    const store = getBestStore(product);
    const image = getImage(product);
    const url = getBestUrl(product);

    let offersHtml = "";

    if (product.offers && product.offers.length) {

      const offers = [...product.offers].slice(0, 4);

      offersHtml = `
        <div class="offers">
          ${offers.map(offer => `
            <div class="offer">
              <span>${escapeHtml(
                offer.store ||
                offer.merchant ||
                offer.retailer ||
                "Store"
              )}</span>

              <span class="offer-price">
                ${escapeHtml(
                  offer.price
                    ? String(offer.price)
                    : ""
                )}
              </span>
            </div>
          `).join("")}
        </div>
      `;
    }

    const card = document.createElement("article");

    card.className = "card";

    card.innerHTML = `
      <div class="image-wrap">
        <img
          src="${escapeHtml(image)}"
          alt="${escapeHtml(product.name || product.title || "Gaming Laptop")}"
          loading="lazy"
          onerror="this.style.display='none'"
        >
      </div>

      <div class="card-content">

        <h2>
          ${escapeHtml(
            product.name ||
            product.title ||
            "Gaming Laptop"
          )}
        </h2>

        <div class="description">
          ${escapeHtml(
            product.description ||
            "Gaming laptop with high-performance hardware."
          )}
        </div>

        <div class="specs">

          ${
            specs.cpu
              ? `<div class="spec"><strong>CPU:</strong> ${escapeHtml(specs.cpu)}</div>`
              : ""
          }

          ${
            specs.gpu
              ? `<div class="spec"><strong>GPU:</strong> ${escapeHtml(specs.gpu)}</div>`
              : ""
          }

          ${
            specs.ram
              ? `<div class="spec"><strong>RAM:</strong> ${escapeHtml(specs.ram)}</div>`
              : ""
          }

          ${
            specs.storage
              ? `<div class="spec"><strong>Storage:</strong> ${escapeHtml(specs.storage)}</div>`
              : ""
          }

          ${
            specs.screen
              ? `<div class="spec"><strong>Screen:</strong> ${escapeHtml(specs.screen)}</div>`
              : ""
          }

        </div>

        <div class="price">
          ${formatPrice(price)}
        </div>

        ${
          store
            ? `<div class="store">Best offer: ${escapeHtml(store)}</div>`
            : ""
        }

        ${offersHtml}

        <a
          class="deal-button"
          href="${escapeHtml(url)}"
          target="_blank"
          rel="nofollow sponsored noopener"
        >
          View Best Deal
        </a>

      </div>
    `;

    container.appendChild(card);
  });
}

function applyFilters() {

  const search = document
    .getElementById("search")
    .value
    .toLowerCase()
    .trim();

  const sort = document.getElementById("sort").value;

  let filtered = allLaptops.filter(product => {

    const text = [
      product.name,
      product.title,
      product.description,
      product.cpu,
      product.gpu,
      product.ram,
      product.storage,
      product.category,
      JSON.stringify(product.specifications || {})
    ]
    .join(" ")
    .toLowerCase();

    return text.includes(search);
  });

  if (sort === "low") {
    filtered.sort((a, b) => {
      return (getPrice(a) || 999999) - (getPrice(b) || 999999);
    });
  }

  if (sort === "high") {
    filtered.sort((a, b) => {
      return (getPrice(b) || 0) - (getPrice(a) || 0);
    });
  }

  if (sort === "name") {
    filtered.sort((a, b) => {
      const nameA = a.name || a.title || "";
      const nameB = b.name || b.title || "";

      return nameA.localeCompare(nameB);
    });
  }

  renderProducts(filtered);
}

async function loadProducts() {

  try {

    const response = await fetch("/products.json", {
      cache: "no-store"
    });

    if (!response.ok) {
      throw new Error("Could not load products.json");
    }

    const products = await response.json();

    /*
      IMPORTANT:
      Both "Laptop" and "Gaming Laptop"
      are included here.
    */

    allLaptops = products.filter(product =>
      product.category === "Laptop" ||
      product.category === "Gaming Laptop"
    );

    applyFilters();

  } catch (error) {

    console.error(error);

    const status = document.getElementById("status");

    status.className = "empty";
    status.style.display = "block";

    status.textContent =
      "Unable to load gaming laptops right now.";
  }
}

document
  .getElementById("search")
  .addEventListener("input", applyFilters);

document
  .getElementById("sort")
  .addEventListener("change", applyFilters);

loadProducts();

</script>

</body>
</html>
